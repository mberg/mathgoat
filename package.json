{
  "name": "mathgoat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --ip 0.0.0.0 --port 8789",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests *.ts *.json *.jsonc *.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@observablehq/plot": "^0.6.17",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.132.0"
  }
}
